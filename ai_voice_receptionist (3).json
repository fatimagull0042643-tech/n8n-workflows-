    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || $input.first().json.output || '{}';\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { summary: raw, intent: 'Unknown', action_items: [], follow_up_required: true, appointment_booked: false, escalated: false };\n}\nreturn [{ json: { ...parsed, call_id: $('Prepare Call End Data').first().json.call_id, caller_phone: $('Prepare Call End Data').first().json.caller_phone, end_time: $('Prepare Call End Data').first().json.end_time } }];"
      },
