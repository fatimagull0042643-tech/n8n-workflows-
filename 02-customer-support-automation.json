{
  "name": "02 - Customer Support Automation",
  "nodes": [
    {
      "id": "trigger",
      "name": "New Support Ticket",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "new-ticket",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "prep",
      "name": "Prepare Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "source",
              "value": "support_ticket",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "ai",
      "name": "AI Processing",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.8,
      "position": [
        680,
        300
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a support triage assistant. Classify urgency (low/medium/high) and draft a first-response reply. Output JSON: {urgency, reply_draft}."
            },
            {
              "role": "user",
              "content": "={{ JSON.stringify($json) }}"
            }
          ]
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "PLACEHOLDER",
          "name": "OpenAi account"
        }
      }
    },
    {
      "id": "if",
      "name": "Check Condition",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.output || $json.text || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "act_true",
      "name": "Send Reply (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        1140,
        180
      ],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "Re: Your support request",
        "message": "={{ $json.output }}"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "PLACEHOLDER",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "act_false",
      "name": "Notify - Needs Review",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        1140,
        420
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "general",
          "mode": "name"
        },
        "text": "\u26a0\ufe0f 02 - Customer Support Automation: item flagged for manual review.\n{{ JSON.stringify($json) }}"
      },
      "credentials": {
        "slackApi": {
          "id": "PLACEHOLDER",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "New Support Ticket": {
      "main": [
        [
          {
            "node": "Prepare Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Data": {
      "main": [
        [
          {
            "node": "AI Processing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Processing": {
      "main": [
        [
          {
            "node": "Check Condition",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Condition": {
      "main": [
        [
          {
            "node": "Send Reply (Gmail)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify - Needs Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}