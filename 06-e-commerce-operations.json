{
  "name": "06 - E-commerce Operations",
  "nodes": [
    {
      "id": "trigger",
      "name": "New Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "new-order",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "prep",
      "name": "Prepare Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "source",
              "value": "ecommerce_order",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "ai",
      "name": "AI Processing",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.8,
      "position": [
        680,
        300
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an e-commerce ops assistant. Check order details, flag any inventory or fraud risk, and draft a customer confirmation message. Output JSON: {risk_flag, confirmation_message}."
            },
            {
              "role": "user",
              "content": "={{ JSON.stringify($json) }}"
            }
          ]
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "PLACEHOLDER",
          "name": "OpenAi account"
        }
      }
    },
    {
      "id": "if",
      "name": "Check Condition",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.output || $json.text || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "act_true",
      "name": "Update Inventory Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [
        1140,
        180
      ],
      "parameters": {
        "operation": "appendOrUpdate",
        "sheetId": {
          "__rl": true,
          "value": "PLACEHOLDER_SHEET_ID",
          "mode": "id"
        },
        "documentId": {
          "__rl": true,
          "value": "PLACEHOLDER_DOC_ID",
          "mode": "id"
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "PLACEHOLDER",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "act_false",
      "name": "Notify - Needs Review",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        1140,
        420
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "general",
          "mode": "name"
        },
        "text": "\u26a0\ufe0f 06 - E-commerce Operations: item flagged for manual review.\n{{ JSON.stringify($json) }}"
      },
      "credentials": {
        "slackApi": {
          "id": "PLACEHOLDER",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "New Order Webhook": {
      "main": [
        [
          {
            "node": "Prepare Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Data": {
      "main": [
        [
          {
            "node": "AI Processing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Processing": {
      "main": [
        [
          {
            "node": "Check Condition",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Condition": {
      "main": [
        [
          {
            "node": "Update Inventory Sheet",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify - Needs Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}